# -----------------------------------------------------------------------------
# Frontend environment — copy to `.env` and adjust. `.env` is gitignored.
# Only VITE_-prefixed vars are exposed to the browser bundle.
# -----------------------------------------------------------------------------

# Base URL the app uses for API calls (axios baseURL).
# Through nginx (docker compose), "/api" is proxied to the backend once it lands.
# For a direct host run without nginx, point at the backend, e.g.:
#   VITE_API_URL=http://localhost:8000/api
VITE_API_URL=/api

# -----------------------------------------------------------------------------
# Google OAuth. Generate a Client ID at
# https://console.cloud.google.com/apis/credentials (Application type: Web
# application) and add the ORIGIN the app runs on — http://localhost:5173 —
# to "Authorized JavaScript origins". The popup button needs no redirect URI.
# Paste the same Client ID below and set GOOGLE_OAUTH2_CLIENT_ID on the backend
# (it is the audience the ID token must be minted for):
#   VITE_GOOGLE_CLIENT_ID=656123456789-abcdefgh1234567890.apps.googleusercontent.com
# Leave it unset and the auth pages disable the Google button and say why.
# -----------------------------------------------------------------------------
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Origin for absolute links that leave the app — currently the emergency URL the QR
# on the emergency card carries. Unset, it falls back to whatever origin the app is
# served from, which is correct when the card is scanned on the same network.
# Set it when the card will be scanned elsewhere, e.g. a LAN address so a phone on the
# same Wi-Fi can open it:
#   VITE_PUBLIC_ORIGIN=http://192.168.1.20:5173
# VITE_PUBLIC_ORIGIN=
