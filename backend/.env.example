# =============================================================================
# myHealthLog Backend — Environment Variables
# Copy this to .env and fill in your values. .env is gitignored.
# =============================================================================

# =============================================================================
# Django Core
# =============================================================================
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.local
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
DJANGO_LOG_LEVEL=INFO

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
# DATABASE=postgres
# POSTGRES_DB=postgres
# POSTGRES_USERNAME=postgres
# POSTGRES_PASSWORD=change-me
SQL_ENGINE=django.db.backends.postgresql
SQL_DATABASE=myhealthlog
SQL_USER=postgres
SQL_PASSWORD=change-me
SQL_HOST=postgresdb
SQL_PORT=5432

DATABASE_URL=postgres://postgres:change-me@postgresdb:5432/myhealthlog
# DB_NAME=myhealthlog
# DB_USER=postgres
# DB_PASSWORD=change-me
# DB_HOST=postgresdb
# DB_PORT=5432

# =============================================================================
# Cache & Broker (Redis)
# =============================================================================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# =============================================================================
# JWT
# =============================================================================
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# =============================================================================
# CORS / CSRF (comma-separated list of allowed origins)
# =============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# =============================================================================
# !!! Email
# =============================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL = False
DEFAULT_FROM_EMAIL=your-email@gmail.com

# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-gmail-app-password
# DEFAULT_FROM_EMAIL=your-email@gmail.com

# =============================================================================
# Frontend
# =============================================================================
# FRONTEND_URL=http://localhost:5173
FRONTEND_URL=http://localhost

# =============================================================================
# !!! Google OAuth2
# =============================================================================
GOOGLE_OAUTH2_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH2_CLIENT_SECRET=your-google-oauth-client-secret

# =============================================================================
# !!! Google Gemini AI
# =============================================================================
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL_NAME=gemini-3.8-flash
# Tried in order when the primary model is slow or unavailable.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
# Hard per-request timeout (seconds) so a slow model never hangs a worker.
GEMINI_TIMEOUT_SECONDS=40

# =============================================================================
# File Uploads
# =============================================================================
# Max upload size in bytes (default: 15 MB)
MAX_UPLOAD_SIZE_BYTES=15728640

# =============================================================================
# Emergency AI Summary Cache TTL (seconds, default: 1 hour)
# =============================================================================
EMERGENCY_AI_SUMMARY_CACHE_TTL=3600

# =============================================================================
# AWS S3 (optional — leave blank to use local filesystem)
# =============================================================================
# USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=

# =============================================================================
# Sentry (optional)
# =============================================================================
# SENTRY_DSN=

# =============================================================================
# Private file links
# =============================================================================
# Health files are served only through signed links; how long one stays valid.
FILE_URL_MAX_AGE=21600
